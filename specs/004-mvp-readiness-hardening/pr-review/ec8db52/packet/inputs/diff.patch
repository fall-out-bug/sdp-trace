+func TestAnalyzeFilesReportsFunctionAndFileMetrics(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "sample.go")
+	src := `package sample
+
+func Plain() {}
+
+func Risky(a, b bool, xs []int) int {
+	if a && b {
+		return 1
+	}

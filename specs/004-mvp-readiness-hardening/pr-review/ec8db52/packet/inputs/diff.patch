+				t.Fatalf("gateStateExitCode = %d want %d", got, test.want)
+			}
+		})
+	}
+
+	if !unexpectedFixtureResultFailed(trace.VerifierResult{Result: trace.VerdictFail}) {
+		t.Fatalf("fail verdict should be unexpected failure")

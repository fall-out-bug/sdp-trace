{
  "schema_version": "harness-session-profile-v1",
  "profile_id": "opencode-gsd-session-v1",
  "harness_profile_path": "opencode-gsd-harness-profile.example.json",
  "event_source_path": "opencode-gsd-events-normalized.jsonl",
  "raw_event_source_path": "opencode-gsd-run.jsonl",
  "raw_event_format": "opencode-jsonl-v1",
  "setup_actions": [
    {
      "id": "init-observation-dir",
      "kind": "init",
      "required": true
    },
    {
      "id": "select-session-profile",
      "kind": "profile",
      "required": true
    },
    {
      "id": "install-context-isolation",
      "kind": "context_isolation",
      "required": true
    }
  ],
  "isolation_rules": [
    {
      "id": "hide-evidence-from-discovery",
      "kind": "ignore_line",
      "target_path": ".ignore",
      "pattern": ".evidence/",
      "required": true
    },
    {
      "id": "deny-evidence-read",
      "kind": "json_read_deny",
      "target_path": ".opencode/opencode.json",
      "pattern": "*/.evidence/*",
      "required": true
    }
  ],
  "stream_capture": "disabled"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdp.dev/trace/redaction-policy.schema.json",
  "title": "SDP Trace Redaction Policy",
  "type": "object",
  "required": [
    "policy_id",
    "schema_version",
    "policy_digest",
    "policy_provenance",
    "allowed_retention_modes",
    "redaction_actions",
    "forbidden_committed_persistence_classes",
    "critical_event_families",
    "authority",
    "profile_mappings",
    "unresolved_redaction_impact"
  ],
  "properties": {
    "policy_id": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" },
    "schema_version": { "type": "string", "const": "1.0.0" },
    "policy_digest": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/sha256" },
    "policy_provenance": { "$ref": "#/$defs/provenance" },
    "allowed_retention_modes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/retentionMode" },
      "uniqueItems": true
    },
    "redaction_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["apply_rule", "withhold", "mark_unavailable"] },
      "uniqueItems": true
    },
    "forbidden_committed_persistence_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "credentials",
          "tokens",
          "raw_prompts",
          "raw_model_responses",
          "source_snippets",
          "stdout_stderr_bodies",
          "oidc_tokens",
          "adapter_secrets",
          "gateway_tokens",
          "checkpoint_key_material"
        ]
      },
      "uniqueItems": true
    },
    "critical_event_families": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://schemas.sdp.dev/trace/flight-recorder-event.schema.json#/$defs/eventType" },
      "uniqueItems": true
    },
    "withholding_requires_authority": { "type": "boolean" },
    "authority": { "$ref": "#/$defs/authorityRef" },
    "profile_mappings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profileMapping" }
    },
    "unresolved_redaction_impact": {
      "enum": ["fail_forensic_retention", "cannot_verify_when_reason_inaccessible", "not_assessed_for_safe_default"]
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "retentionMode": {
      "enum": ["digest_only", "sanitized_excerpt", "encrypted_raw_ref", "external_artifact_ref", "not_assessed"]
    },
    "provenance": {
      "type": "object",
      "required": ["source", "digest"],
      "properties": {
        "source": { "enum": ["builtin", "vcs", "ci_config", "human_signed", "customer_policy_equivalent"] },
        "digest": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": ["rule_id", "detector_family", "rule_version", "action"],
      "properties": {
        "rule_id": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" },
        "detector_family": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" },
        "rule_version": { "type": "string" },
        "action": { "enum": ["apply_rule", "withhold", "mark_unavailable"] },
        "retention_mode": { "$ref": "#/$defs/retentionMode" }
      },
      "additionalProperties": false
    },
    "authorityRef": {
      "type": "object",
      "required": ["actor_id", "verification_state"],
      "properties": {
        "actor_id": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" },
        "verification_state": { "enum": ["verified", "self_claimed", "not_assessed"] },
        "evidence_digest": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "profileMapping": {
      "type": "object",
      "required": ["event_family", "required_retention_modes"],
      "properties": {
        "event_family": { "$ref": "https://schemas.sdp.dev/trace/flight-recorder-event.schema.json#/$defs/eventType" },
        "required_retention_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/retentionMode" },
          "uniqueItems": true
        },
        "critical": { "type": "boolean" },
        "downgrade_reason": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" },
        "authority": { "$ref": "#/$defs/authorityRef" }
      },
      "additionalProperties": false
    }
  }
}

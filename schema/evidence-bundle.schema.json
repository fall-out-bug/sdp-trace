{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdp.dev/trace/evidence-bundle.schema.json",
  "title": "SDP Trace Evidence Bundle",
  "type": "object",
  "required": ["id", "scope", "items"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceItem" }
    }
  },
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "required": ["kind", "source", "summary"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["test", "ci", "review", "diff", "file", "command", "manual"]
        },
        "source": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["pass", "warn", "fail", "not_assessed"]
        },
        "status_origin": {
          "type": "string",
          "enum": ["external", "not_assessed"]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

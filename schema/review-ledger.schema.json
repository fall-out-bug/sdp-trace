{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdp.dev/trace/review-ledger.schema.json",
  "title": "SDP Trace Review Ledger",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "scope",
    "ledger_type",
    "closure_state",
    "generated_at",
    "findings",
    "profile_results",
    "blocking_states",
    "accountability"
  ],
  "properties": {
    "id": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" },
    "schema_version": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/semver" },
    "scope": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" },
    "ledger_type": {
      "type": "string",
      "enum": ["review_closure", "implementation_closure", "external_blocker"]
    },
    "closure_state": {
      "type": "string",
      "enum": ["closed", "closed_for_block_08_activation", "blocked", "not_assessed"]
    },
    "generated_at": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/timestamp" },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/finding" }
    },
    "profile_results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profileResult" }
    },
    "blocking_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/blockingState" }
    },
    "activation_decision": {
      "type": "object",
      "required": ["block_08_allowed", "reason"],
      "properties": {
        "block_08_allowed": { "type": "boolean" },
        "reason": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "accountability": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/accountability" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "closure_state": { "const": "closed_for_block_08_activation" } },
        "required": ["closure_state"]
      },
      "then": {
        "required": ["activation_decision", "blocking_states"],
        "properties": {
          "activation_decision": {
            "properties": { "block_08_allowed": { "const": true } },
            "required": ["block_08_allowed"]
          },
          "blocking_states": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "closure_state": { "const": "closed" } },
        "required": ["closure_state"]
      },
      "then": {
        "properties": { "blocking_states": { "maxItems": 0 } }
      }
    }
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["id", "severity", "source", "summary", "disposition", "closure"],
      "properties": {
        "id": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" },
        "severity": {
          "type": "string",
          "enum": ["critical", "major", "minor", "informational"]
        },
        "source": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" },
        "summary": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" },
        "disposition": {
          "type": "string",
          "enum": ["accepted", "rejected", "recorded", "blocked"]
        },
        "closure": {
          "type": "string",
          "enum": ["closed", "blocking", "not_assessed"]
        },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/ref" }
        }
      },
      "additionalProperties": false
    },
    "profileResult": {
      "type": "object",
      "required": ["profile", "result", "evidence_ref"],
      "properties": {
        "profile": {
          "type": "string",
          "enum": ["repo_baseline_structural", "source_bound_local_release", "external_production_trust"]
        },
        "result": {
          "type": "string",
          "enum": ["pass", "fail", "cannot_verify", "not_assessed"]
        },
        "evidence_ref": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/ref" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "blockingState": {
      "type": "object",
      "required": ["profile", "state_id", "result", "reason"],
      "properties": {
        "profile": { "const": "external_production_trust" },
        "state_id": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" },
        "result": {
          "type": "string",
          "enum": ["fail", "cannot_verify", "not_assessed"]
        },
        "reason": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

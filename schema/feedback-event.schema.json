{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdp.dev/trace/feedback-event.schema.json",
  "title": "SDP Trace Feedback Event",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "kind",
    "from",
    "to",
    "summary",
    "message",
    "trust_scope",
    "proof_state",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "sdp-trace-feedback-event-v1" },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[A-Za-z0-9_.:-]+-[0-9a-f]{12}-[0-9a-f]{8}$"
    },
    "event_type": { "type": "string", "const": "feedback" },
    "kind": { "$ref": "#/$defs/safeToken" },
    "from": { "$ref": "#/$defs/safeToken" },
    "to": { "$ref": "#/$defs/safeToken" },
    "source_ref": { "$ref": "#/$defs/safeToken" },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "message": {
      "type": "object",
      "required": ["retained", "sha256", "bytes", "body"],
      "properties": {
        "retained": { "type": "boolean", "const": true },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      },
      "additionalProperties": false
    },
    "trust_scope": { "type": "string", "const": "local_structural" },
    "proof_state": { "type": "string", "const": "not_assessed" },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "safeToken": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    }
  }
}

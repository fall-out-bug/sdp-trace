{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdp.dev/trace/adapter-registry.schema.json",
  "title": "SDP Trace Adapter Registry",
  "type": "object",
  "required": ["schema_version", "registry_id", "provenance", "adapters"],
  "properties": {
    "schema_version": { "type": "string", "const": "block17-adapter-registry-v1" },
    "registry_id": { "type": "string", "minLength": 1 },
    "provenance": { "$ref": "managed-harness-policy.schema.json#/$defs/provenance" },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/adapter" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "adapter": {
      "type": "object",
      "required": [
        "adapter_id",
        "harness_id",
        "version",
        "deployment_ref",
        "identity_state",
        "authority_ref",
        "allowed_events",
        "capabilities"
      ],
      "properties": {
        "adapter_id": { "type": "string", "minLength": 1 },
        "harness_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "deployment_ref": { "type": "string", "minLength": 1 },
        "identity_state": {
          "type": "string",
          "enum": ["verified", "self_claimed", "unauthorized", "not_assessed"]
        },
        "authority_ref": { "type": "string", "minLength": 1 },
        "allowed_events": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "capability_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/capability" }
        }
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": ["id", "event_types", "provenance_scope"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "event_types": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "provenance_scope": {
          "type": "string",
          "enum": ["local_observed", "harness_observed", "ci_witnessed"]
        },
        "required_payload_digest_fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}

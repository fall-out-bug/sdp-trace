{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdp-trace.local/schema/pr-review-validation.schema.json",
  "title": "PR Review Validation",
  "type": "object",
  "required": [
    "schema_version",
    "packet_digest",
    "review_coverage_state",
    "authority_scope",
    "merge_decision",
    "release_decision",
    "risk_acceptance",
    "plane_results",
    "findings",
    "reasons",
    "next_actions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "block30-pr-review-validation-v1" },
    "packet_digest": { "$ref": "pr-review-common.schema.json#/$defs/packetDigest" },
    "review_coverage_state": { "enum": ["coverage_satisfied", "coverage_partial", "coverage_unresolved", "not_assessed", "cannot_verify"] },
    "authority_scope": { "const": "review_record_only" },
    "merge_decision": { "const": "not_authorized_by_sdp_trace" },
    "release_decision": { "const": "not_authorized_by_sdp_trace" },
    "risk_acceptance": { "const": "not_authorized_by_sdp_trace" },
    "plane_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["plane", "status", "usable"],
        "additionalProperties": false,
        "properties": {
          "plane": { "type": "string", "minLength": 1 },
          "status": {
            "enum": [
              "findings_reported",
              "no_findings",
              "not_assessed",
              "failed",
              "timed_out",
              "empty_output",
              "off_task",
              "parse_failed",
              "cannot_verify"
            ]
          },
          "usable": { "type": "boolean" },
          "review_run_id": { "type": "string" },
          "reason": { "type": "string" },
          "next_action": { "type": "string" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "review_run_id",
          "plane",
          "role_id",
          "severity",
          "summary",
          "citation",
          "disposition"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "review_run_id": { "type": "string", "minLength": 1 },
          "plane": { "type": "string", "minLength": 1 },
          "role_id": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["critical", "major", "minor", "informational"] },
          "summary": { "type": "string", "minLength": 1 },
          "citation": { "$ref": "pr-review-common.schema.json#/$defs/citation" },
          "disposition": {
            "enum": [
              "accepted_fixed",
              "accepted_review_blocking",
              "accepted_narrower",
              "rejected_false_positive",
              "deferred_not_assessed",
              "unresolved_review_blocker"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "disposition_evidence": { "type": "string" }
        }
      }
    },
    "reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_actions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdp.dev/trace/gate-verdict.schema.json",
  "title": "External Gate Verdict",
  "type": "object",
  "required": ["origin", "producer", "gate", "verdict", "evidence"],
  "properties": {
    "origin": { "const": "external" },
    "producer": { "type": "string", "minLength": 1 },
    "gate": { "type": "string", "minLength": 1 },
    "verdict": {
      "type": "string",
      "enum": ["pass", "warn", "fail", "not_assessed", "cannot_verify"]
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "rationale": { "type": "string" },
    "external_policy_ref": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": { "enum": ["pass", "warn", "fail"] }
        },
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "evidence": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": { "enum": ["not_assessed", "cannot_verify"] }
        },
        "required": ["verdict"]
      },
      "then": {
        "required": ["rationale"]
      }
    }
  ],
  "additionalProperties": false
}

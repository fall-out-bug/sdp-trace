{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdp.dev/trace/trace.schema.json",
  "title": "SDP Trace Graph",
  "type": "object",
  "required": ["nodes", "edges"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": [
            "spec",
            "plan",
            "task",
            "change",
            "evidence",
            "observation",
            "metric_sample",
            "metric_stream",
            "external_verdict",
            "decision",
            "actor",
            "accountability",
            "contract_manifest",
            "contract_release_verification"
          ]
        },
        "schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "label": { "type": "string" }
      },
      "propertyNames": { "$ref": "#/$defs/noNativePolicyKey" },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": ["from", "to", "relation"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "relation": {
          "type": "string",
          "enum": [
            "implements",
            "produces",
            "checks",
            "performed_by",
            "references",
            "supports",
            "derived_from",
            "consumes",
            "records_external",
            "accountable_to",
            "verifies"
          ]
        }
      },
      "propertyNames": { "$ref": "#/$defs/noNativePolicyKey" },
      "additionalProperties": true
    },
    "noNativePolicyKey": {
      "not": {
        "enum": [
          "verdict",
          "decision",
          "gate_result",
          "gate_verdict",
          "readiness",
          "readiness_verdict",
          "degradation_status",
          "policy_result",
          "policy_threshold",
          "evidence_strength",
          "quality_score",
          "override_result"
        ]
      }
    }
  },
  "propertyNames": { "$ref": "#/$defs/noNativePolicyKey" },
  "additionalProperties": true
}

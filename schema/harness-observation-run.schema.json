{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdp.dev/trace/harness-observation-run.schema.json",
  "title": "SDP Trace Harness Observation Run",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "harness_family",
    "event_schema_version",
    "source_path",
    "source_digest",
    "event_count",
    "event_refs",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "harness-observation-run-v1" },
    "profile_id": { "$ref": "#/$defs/safeId" },
    "harness_family": { "$ref": "#/$defs/safeId" },
    "event_schema_version": { "const": "harness-event-v1" },
    "source_path": { "type": "string", "minLength": 1 },
    "source_digest": { "$ref": "#/$defs/sha256" },
    "event_count": { "type": "integer", "minimum": 0 },
    "event_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^events/[A-Za-z0-9_-]{1,128}\\.json$" }
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}

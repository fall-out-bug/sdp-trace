{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdp.dev/trace/trusted-identity-policy.schema.json",
  "title": "SDP Trace Trusted Identity Policy",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "oidc_issuer",
    "source_uri",
    "protected_ref",
    "workflow_identity",
    "release_captain",
    "required_approval_refs",
    "created_at",
    "accountability"
  ],
  "properties": {
    "id": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" },
    "schema_version": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/semver" },
    "oidc_issuer": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" },
    "source_uri": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" },
    "protected_ref": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" },
    "workflow_identity": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" },
    "release_captain": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/accountableIdentity" },
    "required_approval_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/ref" }
    },
    "allowed_private_equivalent_profile": {
      "type": "object",
      "required": ["profile", "envelope_binding", "trusted_identity_source", "freshness_evidence", "audit_evidence"],
      "properties": {
        "profile": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" },
        "envelope_binding": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" },
        "trusted_identity_source": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" },
        "freshness_evidence": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" },
        "audit_evidence": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "created_at": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/timestamp" },
    "accountability": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/accountability" }
  },
  "additionalProperties": false
}

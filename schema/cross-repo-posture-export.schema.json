{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdp.dev/trace/cross-repo-posture-export.schema.json",
  "title": "SDP Trace Cross-Repository Posture Export",
  "type": "object",
  "required": [
    "schema_version",
    "export_profile_id",
    "export_profile_version",
    "export_id",
    "producer",
    "generated_at",
    "grouping_set_id",
    "active_grouping_keys",
    "input_selection",
    "metric_rows",
    "movement_rows",
    "movement_summary",
    "refusal_rows",
    "handoff",
    "output_safety"
  ],
  "properties": {
    "schema_version": { "const": "block21-cross-repo-posture-export-v1" },
    "export_profile_id": { "const": "cross-repo-evidence-posture-v1" },
    "export_profile_version": { "const": "v1" },
    "export_id": { "type": "string", "pattern": "^export:[a-f0-9]{16}$" },
    "producer": { "const": "sdp-trace" },
    "generated_at": { "type": "string", "format": "date-time" },
    "grouping_set_id": {
      "enum": ["repo_window_v1", "team_service_window_v1", "harness_change_window_v1"]
    },
    "active_grouping_keys": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/dimensionName" }
    },
    "input_selection": {
      "type": "array",
      "items": { "$ref": "#/$defs/inputSelection" }
    },
    "metric_rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/metricRow" }
    },
    "movement_rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/movementRow" }
    },
    "movement_summary": { "$ref": "#/$defs/movementSummary" },
    "refusal_rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/refusalRow" }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "output_safety": { "$ref": "#/$defs/outputSafety" }
  },
  "$defs": {
    "dimensionName": {
      "enum": ["repo", "team", "service", "harness", "change_type", "time_window"]
    },
    "safeLabel": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "inputTrustState": {
      "enum": ["trusted_input", "stale_input", "untrusted_input", "cannot_verify_input", "not_assessed_input"]
    },
    "refusalReason": {
      "enum": [
        "stale_input",
        "malformed_input",
        "untrusted_input_digest_mismatch",
        "unsafe_label",
        "unsupported_input",
        "missing_required_input",
        "missing_optional_input",
        "non_comparable_metric_version",
        "non_comparable_dimension_key",
        "non_comparable_denominator_basis",
        "non_comparable_input_trust_rule",
        "non_comparable_missing_window",
        "output_safety_violation"
      ]
    },
    "metricID": {
      "enum": [
        "missing_telemetry_rows",
        "not_assessed_rows",
        "cannot_verify_rows",
        "unsupported_observer_rows",
        "not_integrated_rows",
        "retention_limited_rows",
        "local_only_evidence_rows",
        "ci_witnessed_evidence_rows",
        "external_witnessed_evidence_rows",
        "issue_observed_rows",
        "override_rows",
        "late_attach_rows",
        "contract_change_rows"
      ]
    },
    "sourceFieldState": {
      "enum": ["present", "not_assessed", "cannot_verify", "unsupported"]
    },
    "inputSelection": {
      "type": "object",
      "required": ["input_id", "repo", "time_window", "path_redacted_id", "input_trust_state"],
      "properties": {
        "input_id": { "$ref": "#/$defs/safeLabel" },
        "repo": { "$ref": "#/$defs/safeLabel" },
        "time_window": { "$ref": "#/$defs/safeLabel" },
        "path_redacted_id": {
          "type": "string",
          "pattern": "^artifact:[a-z0-9_]+:[a-f0-9]{16}$|^artifact:[a-z0-9_]+:not_assessed0000$"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "input_trust_state": { "$ref": "#/$defs/inputTrustState" }
      },
      "additionalProperties": false
    },
    "metricRow": {
      "type": "object",
      "required": [
        "id",
        "metric_id",
        "metric_version",
        "numerator",
        "denominator",
        "unit",
        "time_window",
        "dimensions",
        "dimension_key",
        "source_input_refs",
        "source_artifact_digest_set_hash",
        "source_field_state",
        "not_assessed_count",
        "input_trust_state_summary"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^metric\\.[0-9]{4}$" },
        "metric_id": { "$ref": "#/$defs/metricID" },
        "metric_version": { "const": "v1" },
        "numerator": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 0 },
        "unit": { "const": "rows" },
        "time_window": { "$ref": "#/$defs/safeLabel" },
        "dimensions": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/dimensionName" },
          "additionalProperties": { "$ref": "#/$defs/safeLabel" }
        },
        "dimension_key": {
          "type": "string",
          "pattern": "^[a-z_]+=([a-z0-9._-]+)(\\|[a-z_]+=([a-z0-9._-]+))*$"
        },
        "source_input_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/safeLabel" }
        },
        "source_artifact_digest_set_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source_field_state": { "$ref": "#/$defs/sourceFieldState" },
        "not_assessed_count": { "type": "integer", "minimum": 0 },
        "input_trust_state_summary": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/inputTrustState" },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      },
      "additionalProperties": false
    },
    "movementRow": {
      "type": "object",
      "required": [
        "id",
        "metric_id",
        "metric_version",
        "dimension_key",
        "current_value",
        "previous_value",
        "delta",
        "comparison_basis",
        "comparable"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^movement\\.[0-9]{4}$" },
        "metric_id": { "$ref": "#/$defs/metricID" },
        "metric_version": { "const": "v1" },
        "dimension_key": { "type": "string", "minLength": 1 },
        "current_metric_row_ref": { "type": "string", "pattern": "^metric\\.[0-9]{4}$" },
        "previous_metric_row_ref": { "type": "string", "pattern": "^metric\\.[0-9]{4}$" },
        "current_value": { "type": "integer", "minimum": 0 },
        "previous_value": { "type": "integer", "minimum": 0 },
        "delta": { "type": "integer" },
        "comparison_basis": {
          "enum": [
            "same_profile_metric_dimension_window",
            "non_comparable_missing_window"
          ]
        },
        "comparable": { "type": "boolean" },
        "non_comparable_reason": {
          "enum": ["non_comparable_missing_window"]
        }
      },
      "additionalProperties": false
    },
    "movementSummary": {
      "type": "object",
      "required": ["comparable_count", "non_comparable_count", "non_comparable_reason_counts"],
      "properties": {
        "comparable_count": { "type": "integer", "minimum": 0 },
        "non_comparable_count": { "type": "integer", "minimum": 0 },
        "non_comparable_reason_counts": {
          "type": "object",
          "propertyNames": { "enum": ["non_comparable_missing_window"] },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      },
      "additionalProperties": false
    },
    "refusalRow": {
      "type": "object",
      "required": ["id", "input_id", "refusal_reason", "input_trust_state"],
      "properties": {
        "id": { "type": "string", "pattern": "^refusal\\.[0-9]{4}$" },
        "input_id": { "$ref": "#/$defs/safeLabel" },
        "time_window": { "$ref": "#/$defs/safeLabel" },
        "refusal_reason": { "$ref": "#/$defs/refusalReason" },
        "input_trust_state": { "$ref": "#/$defs/inputTrustState" }
      },
      "additionalProperties": false
    },
    "outputSafety": {
      "type": "object",
      "required": ["verified_absent_sensitive_classes"],
      "properties": {
        "verified_absent_sensitive_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "raw_command_args",
              "command_name_or_path",
              "unsafe_test_identifier",
              "stdout_stderr_body",
              "prompt_body",
              "source_snippet",
              "tool_payload",
              "adapter_configuration",
              "gateway_evidence_ref",
              "credential_or_token",
              "authenticated_provider_url",
              "model_request_response_payload",
              "raw_review_body",
              "unsafe_raw_reference_note",
              "private_filesystem_path",
              "unsafe_personal_identifier",
              "unsafe_label",
              "raw_digest_manifest_path",
              "free_text_exception_or_refusal_reason"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdp.dev/trace/metric-stream.schema.json",
  "title": "SDP Trace Metric Stream",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "metric_name",
    "dimensions",
    "samples",
    "comparisons",
    "assessment_state",
    "created_at",
    "updated_at"
  ],
  "if": {
    "anyOf": [
      {
        "properties": {
          "samples": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": { "assessment_state": { "enum": ["partial", "not_assessed"] } },
              "required": ["assessment_state"]
            }
          }
        }
      },
      {
        "properties": {
          "comparisons": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": { "assessment_state": { "enum": ["partial", "not_assessed"] } },
              "required": ["assessment_state"]
            }
          }
        }
      }
    ]
  },
  "then": {
    "properties": { "assessment_state": { "enum": ["partial", "not_assessed"] } }
  },
  "properties": {
    "id": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" },
    "schema_version": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/semver" },
    "metric_name": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" },
    "dimensions": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/dimensions" },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sample" }
    },
    "comparisons": {
      "type": "array",
      "items": { "$ref": "#/$defs/comparison" }
    },
    "assessment_state": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/assessmentState" },
    "not_assessed": {
      "type": "array",
      "items": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/notAssessedEntry" }
    },
    "created_at": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/timestamp" },
    "updated_at": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/timestamp" }
  },
  "$defs": {
    "sample": {
      "type": "object",
      "required": [
        "id",
        "value",
        "unit",
        "window_start",
        "window_end",
        "dimensions",
        "evidence_refs",
        "provenance_refs",
        "assessment_state"
      ],
      "if": {
        "properties": { "assessment_state": { "const": "not_assessed" } },
        "required": ["assessment_state"]
      },
      "then": {
        "properties": { "value": { "type": "null" } },
        "required": ["not_assessed_reason"]
      },
      "else": {
        "properties": {
          "evidence_refs": {
            "type": "array",
            "minItems": 1
          }
        }
      },
      "properties": {
        "id": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" },
        "value": {
          "anyOf": [
            { "type": "number" },
            { "type": "integer" },
            { "type": "string" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        },
        "unit": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" },
        "window_start": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/timestamp" },
        "window_end": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/timestamp" },
        "dimensions": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/dimensions" },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/ref" }
        },
        "provenance_refs": {
          "type": "array",
          "items": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/ref" }
        },
        "not_assessed_reason": { "type": "string" },
        "assessment_state": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/assessmentState" }
      },
      "additionalProperties": false
    },
    "comparison": {
      "type": "object",
      "required": [
        "id",
        "previous_sample_ref",
        "current_sample_ref",
        "previous_value",
        "current_value",
        "delta",
        "unit",
        "evidence_coverage",
        "assessment_state"
      ],
      "properties": {
        "id": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" },
        "previous_sample_ref": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/ref" },
        "current_sample_ref": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/ref" },
        "previous_value": {
          "anyOf": [
            { "type": "number" },
            { "type": "integer" },
            { "type": "string" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        },
        "current_value": {
          "anyOf": [
            { "type": "number" },
            { "type": "integer" },
            { "type": "string" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        },
        "delta": {
          "anyOf": [
            { "type": "number" },
            { "type": "integer" },
            { "type": "string" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        },
        "unit": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" },
        "evidence_coverage": {
          "type": "object",
          "required": ["current", "previous"],
          "properties": {
            "current": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/assessmentState" },
            "previous": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/assessmentState" }
          },
          "additionalProperties": false
        },
        "assessment_state": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/assessmentState" },
        "not_assessed_reason": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdp.dev/trace/managed-harness-policy.schema.json",
  "title": "SDP Trace Managed Harness Policy",
  "type": "object",
  "required": [
    "schema_version",
    "policy_id",
    "policy_provenance",
    "authorized_adapters",
    "required_event_groups",
    "witness_binding"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "block17-managed-harness-policy-v1" },
    "policy_id": { "type": "string", "minLength": 1 },
    "policy_provenance": { "$ref": "#/$defs/provenance" },
    "authorized_adapters": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/authorizedAdapter" }
    },
    "authorized_wrappers": {
      "type": "array",
      "items": { "$ref": "#/$defs/authorizedWrapper" }
    },
    "required_event_groups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requiredEventGroup" }
    },
    "suppression_rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/suppressionRule" }
    },
    "witness_binding": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "run_id",
          "run_nonce",
          "source_commit",
          "managed_policy_digest",
          "adapter_registry_digest",
          "adapter_identity_digest",
          "enrollment_event_digest",
          "launch_event_digest",
          "chain_head",
          "event_count",
          "freshness",
          "artifact_digest"
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["source", "digest"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["vcs", "ci_config", "human_signed", "customer_policy_equivalent"]
        },
        "digest": { "$ref": "common.schema.json#/$defs/sha256" },
        "reference": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "authorizedAdapter": {
      "type": "object",
      "required": ["adapter_id", "harness_id", "authority_ref", "deployment_ref", "capability_ids"],
      "properties": {
        "adapter_id": { "type": "string", "minLength": 1 },
        "harness_id": { "type": "string", "minLength": 1 },
        "version_required": { "type": "string", "minLength": 1 },
        "authority_ref": { "type": "string", "minLength": 1 },
        "deployment_ref": { "type": "string", "minLength": 1 },
        "capability_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "authorizedWrapper": {
      "type": "object",
      "required": ["wrapper_id", "authority_ref", "deployment_ref"],
      "properties": {
        "wrapper_id": { "type": "string", "minLength": 1 },
        "version_required": { "type": "string", "minLength": 1 },
        "authority_ref": { "type": "string", "minLength": 1 },
        "deployment_ref": { "type": "string", "minLength": 1 },
        "allowed_command_labels": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "requiredEventGroup": {
      "type": "object",
      "required": ["id", "event_types", "acceptable_provenance_scopes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "event_types": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "acceptable_provenance_scopes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/provenanceScope" },
          "uniqueItems": true
        },
        "suppression_may_satisfy_profile": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "suppressionRule": {
      "type": "object",
      "required": ["event_group", "authority_ref", "policy_provenance_source", "suppression_may_satisfy_profile"],
      "properties": {
        "event_group": { "type": "string", "minLength": 1 },
        "authority_ref": { "type": "string", "minLength": 1 },
        "policy_provenance_source": {
          "type": "string",
          "enum": ["vcs", "ci_config", "human_signed", "customer_policy_equivalent"]
        },
        "suppression_may_satisfy_profile": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "provenanceScope": {
      "type": "string",
      "enum": ["local_observed", "harness_observed", "ci_witnessed"]
    }
  }
}

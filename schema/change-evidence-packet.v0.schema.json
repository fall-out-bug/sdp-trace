{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdp.dev/trace/change-evidence-packet.v0.schema.json",
  "title": "Change Evidence Packet v0",
  "type": "object",
  "required": ["packet_version", "packet_id", "source_change", "generated_at", "authoring_method", "selected_profile", "bundle_ref", "packet_state", "projection", "rows", "non_approval"],
  "properties": {
    "packet_version": { "const": "change-evidence-packet.v0" },
    "packet_id": { "type": "string", "minLength": 1 },
    "source_change": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "change_id": { "type": "string" },
        "url": { "type": "string" },
        "base_ref": { "type": "string" },
        "head_ref": { "type": "string" },
        "commit_range": { "type": "string" },
        "head_sha": { "type": "string" }
      },
      "additionalProperties": false
    },
    "generated_at": { "type": "string", "minLength": 1 },
    "authoring_method": { "type": "string", "enum": ["tool_generated", "hand_authored_before_tooling"] },
    "selected_profile": { "type": "string", "minLength": 1 },
    "redaction_policy": { "type": "string" },
    "bundle_ref": { "type": "string", "minLength": 1 },
    "packet_state": { "type": "string", "enum": ["draft", "review_ready", "reviewed", "superseded"] },
    "projection": {
      "type": "object",
      "required": ["kind", "canonical"],
      "properties": {
        "kind": { "type": "string" },
        "canonical": { "type": "boolean" },
        "artifact_ref": { "type": "string" }
      },
      "additionalProperties": false
    },
    "rows": {
      "type": "array",
      "minItems": 11,
      "items": { "$ref": "#/$defs/row" },
      "allOf": [
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "PC-CHANGE" } } } },
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "PC-INITIATOR" } } } },
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "PC-AGENT-ROUTE" } } } },
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "PC-MUTATION" } } } },
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "PC-VERIFICATION" } } } },
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "PC-REVIEW" } } } },
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "PC-AUTHORITY" } } } },
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "PC-THEATER" } } } },
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "PC-ATTESTATION" } } } },
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "PC-DECISION" } } } },
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "PC-RESIDUAL-GAPS" } } } }
      ]
    },
    "theater_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/theaterFinding" }
    },
    "residual_gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/residualGap" }
    },
    "decision_owners": {
      "type": "array",
      "items": { "$ref": "#/$defs/decisionOwner" }
    },
    "non_approval": { "type": "string", "minLength": 1 },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "state": {
      "type": "string",
      "enum": ["pass", "partial", "fail", "cannot_verify", "not_assessed", "not_in_scope"]
    },
    "rowId": {
      "type": "string",
      "enum": ["PC-CHANGE", "PC-INITIATOR", "PC-AGENT-ROUTE", "PC-MUTATION", "PC-VERIFICATION", "PC-REVIEW", "PC-AUTHORITY", "PC-THEATER", "PC-ATTESTATION", "PC-DECISION", "PC-RESIDUAL-GAPS"]
    },
    "row": {
      "type": "object",
      "required": ["id", "state", "summary", "evidence_refs", "owner"],
      "properties": {
        "id": { "$ref": "#/$defs/rowId" },
        "state": { "$ref": "#/$defs/state" },
        "summary": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "reason": { "type": "string" },
        "owner": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
      ,
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "pass" } }, "required": ["state"] },
          "then": { "properties": { "evidence_refs": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "state": { "enum": ["partial", "fail", "cannot_verify", "not_assessed", "not_in_scope"] } }, "required": ["state"] },
          "then": { "required": ["reason"], "properties": { "reason": { "minLength": 1 } } }
        }
      ]
    },
    "theaterFinding": {
      "type": "object",
      "required": ["reason_code", "state", "finding", "trigger_evidence_refs"],
      "properties": {
        "reason_code": {
          "type": "string",
          "enum": ["agent_claimed_verification", "unbound_intent", "ci_theater", "scope_theater"]
        },
        "state": { "$ref": "#/$defs/state" },
        "severity": { "type": "string" },
        "finding": { "type": "string", "minLength": 1 },
        "trigger_evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "required_closure_evidence": { "type": "string" }
      },
      "additionalProperties": false
    },
    "residualGap": {
      "type": "object",
      "required": ["row_id", "state", "reason"],
      "properties": {
        "row_id": { "$ref": "#/$defs/rowId" },
        "state": { "$ref": "#/$defs/state" },
        "reason": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "closure_evidence": { "type": "string" }
      },
      "additionalProperties": false
    },
    "decisionOwner": {
      "type": "object",
      "required": ["decision", "owner", "state"],
      "properties": {
        "decision": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "state": { "$ref": "#/$defs/state" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

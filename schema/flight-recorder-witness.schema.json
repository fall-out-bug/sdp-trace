{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdp.dev/trace/flight-recorder-witness.schema.json",
  "title": "SDP Trace Flight Recorder Witness Entry",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "source_baseline_hash",
    "task_hash",
    "recorder_version",
    "chain_head",
    "witness_time",
    "witness_scope",
    "profile",
    "digest_algorithm",
    "artifact_role",
    "trust_scope",
    "witness_identity"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" },
    "source_baseline_hash": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/sha256" },
    "task_hash": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/sha256" },
    "recorder_version": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/semver" },
    "chain_head": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/sha256" },
    "witness_time": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/timestamp" },
    "witness_scope": {
      "type": "string",
      "enum": ["local_file_witness", "external_witness_extension"]
    },
    "profile": {
      "type": "string",
      "enum": ["witnessed_run_recorder", "externally_witnessed_run"]
    },
    "digest_algorithm": { "const": "sha256" },
    "artifact_role": {
      "type": "string",
      "enum": ["witness_entry", "untrusted_shape_example", "negative_verifier_fixture"]
    },
    "trust_scope": {
      "type": "string",
      "enum": ["witnessed_run_recorder", "externally_witnessed_run", "untrusted_shape_only"]
    },
    "witness_identity": {
      "type": "object",
      "required": ["witness_id", "uri"],
      "properties": {
        "witness_id": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" },
        "uri": { "$ref": "https://schemas.sdp.dev/trace/common.schema.json#/$defs/nonEmptyString" },
        "controlled_by_recorded_agent": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "profile": { "const": "witnessed_run_recorder" } }, "required": ["profile"] },
      "then": {
        "properties": {
          "witness_scope": { "const": "local_file_witness" },
          "trust_scope": { "const": "witnessed_run_recorder" }
        }
      }
    },
    {
      "if": { "properties": { "profile": { "const": "externally_witnessed_run" } }, "required": ["profile"] },
      "then": {
        "properties": {
          "witness_scope": { "const": "external_witness_extension" },
          "trust_scope": { "const": "externally_witnessed_run" }
        }
      }
    }
  ],
  "additionalProperties": false
}

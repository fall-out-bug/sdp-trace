{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdp.dev/trace/run-manifest.schema.json",
  "title": "SDP Trace Run Manifest",
  "description": "Current live run.json manifest emitted by sdp-trace wrap.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "recorder_version",
    "created_at",
    "contract_id",
    "source_snapshot_state",
    "event_count",
    "closure_state"
  ],
  "properties": {
    "schema_version": { "const": "block10-event-v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "recorder_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "closed_at": { "type": "string", "format": "date-time" },
    "task": { "type": "string" },
    "contract_id": { "type": "string", "minLength": 1 },
    "contract_path": { "type": "string" },
    "contract_digest": { "$ref": "#/$defs/sha256" },
    "source_snapshot_digest": { "$ref": "#/$defs/sha256" },
    "source_snapshot_state": {
      "type": "string",
      "enum": ["git_tree_clean", "git_tree_dirty", "not_assessed", "unknown", ""]
    },
    "event_count": { "type": "integer", "minimum": 0 },
    "event_chain_head": { "$ref": "#/$defs/sha256" },
    "final_chain_head": { "$ref": "#/$defs/sha256" },
    "closure_state": {
      "type": "string",
      "enum": ["completed", "command_failed", "unknown"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "event_count": { "minimum": 1 } },
        "required": ["event_count"]
      },
      "then": {
        "required": ["event_chain_head", "final_chain_head"]
      }
    },
    {
      "if": {
        "properties": {
          "closure_state": { "enum": ["completed", "command_failed"] }
        },
        "required": ["closure_state"]
      },
      "then": {
        "required": ["closed_at"]
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
